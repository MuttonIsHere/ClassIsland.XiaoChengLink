<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ─── 小橙看班联动（XiaoChengLink）—— ClassIsland 2.1 插件工程 ───────────────
    · 目标框架：net8.0-windows
      宿主 ClassIsland 2.1.0.1 运行时为 net8.0 + Microsoft.WindowsDesktop.App 自包含，
      官方示例插件使用 net8.0；本插件需要 System.Windows.Automation（UIA）读取窗口文本，
      所以加了 -windows + UseWPF=true（仅编译期引用 WPF/UIA 程序集，不会启动 WPF）。
      ClassIsland 2.x 的 UI 是 Avalonia，插件不要碰 WPF Dispatcher / Avalonia UI。
    · EnableDynamicLoading：被宿主 AssemblyLoadContext 动态加载所必需（生成 .deps.json 供依赖解析）。
    · CreateCipx：ClassIsland.PluginSdk.targets 提供的打包 Target（需输出目录已有 manifest.yml）。
    · 注意：不要把这些程序集复制进插件输出：ClassIsland.Core/Shared、Avalonia、Microsoft.Extensions.*
      （由宿主 Default ALC 提供）。PackageReference 的 ExcludeAssets=runtime;native 就是为此。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>XiaoChengLink</AssemblyName>
    <RootNamespace>XiaoChengLink</RootNamespace>
    <Version>1.3.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <UseWPF>true</UseWPF>
    <CreateCipx>true</CreateCipx>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.0.1">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="settings.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="read-message.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DbBridge\XiaoChengDbBridge.cs">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

