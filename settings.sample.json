{
  "processNames": ["inArt_PC"],
  "windowTitlePatterns": ["消息提醒", "班级课表"],
  "windowClassPatterns": ["^FMTfrm", "^TForm", "^Tfrm"],
  "ignoreWindowClassPatterns": ["^FMTfrmIcon$", "^TfrmTrayIcon$", "^TFMAppClass$"],
  "keywordMatchWindowTitle": false,
  "notificationThrottleSeconds": 12,
  "pollIntervalMs": 1500,
  "keywords": ["消息", "提醒", "作业", "考试", "通知", "点名", "请假"],
  "keywordMatchMode": "Contains",
  "triggerOnWindowAppear": true,
  "triggerOnVisualChange": true,
  "visualChangeThresholdPercent": 0.4,
  "visualChangeMinAreaPixels": 10000,
  "diagnosticLogIntervalSeconds": 30,
  "readMessageBodyFromDatabase": true,
  "messageDatabasePath": "",
  "messageBodyMaxAgeSeconds": 3600,
  "messageBodyFreshSeconds": 30,
  "messageBodyMaxChars": 300,
  "triggerOnExistingWindows": false,
  "cooldownSeconds": 60,
  "notificationDurationSeconds": 8,
  "maskDurationSeconds": 3,
  "textSources": {
    "uia": false,
    "win32": true,
    "windowTitle": true
  }
}
